import sys # Модуль для запуска программы
# Импортируем инструменты PyQt
from PyQt5.QtWidgets import QApplication, QWidget, QLabel, QRadioButton, QVBoxLayout, QMessageBox


# Создаем класс окна (наследник QWidget)
class TestWindow(QWidget):
    # Конструктор окна
    def __init__(self):
        super().__init__() # Настройка родителя
        
        self.setWindowTitle("Тест для спонсоров") # Заголовок окна
        self.resize(500, 300) # Размер окна (сделали чуть больше)

        # Создаем вертикальную сетку
        layout = QVBoxLayout()

        # Создаем текст вопроса
        question = QLabel("Как звали первого ютуб-блогера, набравшего 100000000 подписчиков?")
        layout.addWidget(question) # Кладем вопрос в сетку

        # Создаем 6 кнопок с вариантами ответов
        self.rb1 = QRadioButton("PewDiePie")
        self.rb2 = QRadioButton("Рэт и Линк")
        self.rb3 = QRadioButton("SlivkiShow")
        self.rb4 = QRadioButton("TheBrianMaps")
        self.rb5 = QRadioButton("Mister Max")
        self.rb6 = QRadioButton("EeOneGuy")

        # Добавляем все 6 кнопок в сетку
        layout.addWidget(self.rb1)
        layout.addWidget(self.rb2)
        layout.addWidget(self.rb3)
        layout.addWidget(self.rb4)
        layout.addWidget(self.rb5)
        layout.addWidget(self.rb6)

        # Привязка кликов мышкой
        self.rb1.clicked.connect(self.show_win)  # Клик по PewDiePie - победа
        self.rb2.clicked.connect(self.show_lose) # Остальные - проигрыш
        self.rb3.clicked.connect(self.show_lose)
        self.rb4.clicked.connect(self.show_lose)
        self.rb5.clicked.connect(self.show_lose)
        self.rb6.clicked.connect(self.show_lose)

        # Устанавливаем сетку в окно
        self.setLayout(layout)

    # Функция для правильного ответа
    def show_win(self):
        msg = QMessageBox() # Создаем окошко
        msg.setText("Вы выиграли встречу с создателями канала") # Текст
        msg.exec_() # Показываем

    # Функция для неправильного ответа
    def show_lose(self):
        msg = QMessageBox() # Создаем окошко
        msg.setText("Повезёт в другой раз!") # Текст
        msg.exec_() # Показываем


# ЗАПУСК ПРОГРАММЫ
if __name__ == '__main__':
    app = QApplication(sys.argv) # Создаем приложение
    window = TestWindow()        # Создаем наше окно
    window.show()                # Показываем его
    sys.exit(app.exec_())        # Запускаем цикл работы
