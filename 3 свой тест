# ============================================
# Memory Card: интерфейс приложения (PyQt5)
# ============================================

# --- 1. Подключаем инструменты ---
from PyQt5.QtCore import Qt   # нужен для выравнивания (Qt.AlignLeft и др.)
from PyQt5.QtWidgets import (
    QApplication, QWidget,         # приложение и окно
    QHBoxLayout, QVBoxLayout,      # горизонтальная и вертикальная "полки"
    QGroupBox, QRadioButton,       # рамка и переключатели
    QPushButton, QLabel            # кнопка и надпись
)

# Создаём приложение. Всегда делаем это до создания виджетов.
app = QApplication([])


# --- 2. Создаём виджеты (детали) ---

# Панель вопроса
btn_OK = QPushButton('Ответить')                         # кнопка "Ответить"
lb_Question = QLabel('Самый сложный вопрос в мире!')     # текст вопроса

# Рамка для вариантов ответа
RadioGroupBox = QGroupBox('Варианты ответов')

# Четыре переключателя (выбрать можно только один)
rbtn_1 = QRadioButton('Вариант 1')
rbtn_2 = QRadioButton('Вариант 2')
rbtn_3 = QRadioButton('Вариант 3')
rbtn_4 = QRadioButton('Вариант 4')


# --- 3. Раскладываем 4 варианта в 2 столбца ---
layout_ans1 = QHBoxLayout()   # главная полка: столбцы стоят в ряд
layout_ans2 = QVBoxLayout()   # левый столбец (сверху вниз)
layout_ans3 = QVBoxLayout()   # правый столбец (сверху вниз)

layout_ans2.addWidget(rbtn_1)   # два варианта в левый столбец
layout_ans2.addWidget(rbtn_2)
layout_ans3.addWidget(rbtn_3)   # два варианта в правый столбец
layout_ans3.addWidget(rbtn_4)

layout_ans1.addLayout(layout_ans2)   # столбцы кладём в одну строку
layout_ans1.addLayout(layout_ans3)

RadioGroupBox.setLayout(layout_ans1)   # готовую строку кладём в рамку


# --- 4. Панель результата ---
AnsGroupBox = QGroupBox('Результат теста')   # вторая рамка
lb_Result = QLabel('прав ты или нет?')       # здесь будет "Правильно" / "Неправильно"
lb_Correct = QLabel('ответ будет тут!')      # здесь будет правильный ответ

layout_res = QVBoxLayout()
# Result прижимаем влево и вверх
layout_res.addWidget(lb_Result, alignment=(Qt.AlignLeft | Qt.AlignTop))
# Correct ставим по центру и даём ему больше места (stretch=2)
layout_res.addWidget(lb_Correct, alignment=Qt.AlignHCenter, stretch=2)

AnsGroupBox.setLayout(layout_res)   # кладём в рамку


# --- 5. Собираем три строки окна ---
layout_line1 = QHBoxLayout()   # строка 1: вопрос
layout_line2 = QHBoxLayout()   # строка 2: варианты ИЛИ результат
layout_line3 = QHBoxLayout()   # строка 3: кнопка "Ответить"

# Строка 1: вопрос по центру
layout_line1.addWidget(lb_Question, alignment=(Qt.AlignHCenter | Qt.AlignVCenter))

# Строка 2: кладём обе рамки в одну строку. Видна будет только одна.
layout_line2.addWidget(RadioGroupBox)
layout_line2.addWidget(AnsGroupBox)
RadioGroupBox.hide()   # прячем рамку с вариантами, показываем результат
# Чтобы увидеть варианты ответов, замените на: AnsGroupBox.hide()

# Строка 3: кнопка по центру
layout_line3.addStretch(1)                  # пустое место слева
layout_line3.addWidget(btn_OK, stretch=2)   # кнопка (большая)
layout_line3.addStretch(1)                  # пустое место справа


# --- 6. Собираем окно ---
layout_card = QVBoxLayout()   # главная полка: строки друг под другом

layout_card.addLayout(layout_line1, stretch=2)   # вопрос: 2 части места
layout_card.addLayout(layout_line2, stretch=8)   # ответы: 8 частей (больше всего)
layout_card.addStretch(1)                        # пустое место
layout_card.addLayout(layout_line3, stretch=1)   # кнопка: 1 часть
layout_card.addStretch(1)                        # пустое место
layout_card.setSpacing(5)                        # расстояние между строками

window = QWidget()                     # создаём окно
window.setLayout(layout_card)          # кладём главную полку в окно
window.setWindowTitle('Memory Card')   # заголовок окна
window.show()                          # показываем окно

app.exec_()   # запускаем приложение (без этого окно сразу закроется)
