import sys # Импортируем модуль sys для правильного запуска/закрытия программы
# Импортируем нужные инструменты из библиотеки PyQt5
from PyQt5.QtWidgets import QApplication, QWidget, QLabel, QRadioButton, QVBoxLayout, QMessageBox


# Создаем класс нашего окна, наследуясь от QWidget (базовое пустое окно)
class ContestWindow(QWidget):
    # Конструктор окна
    def __init__(self):
        super().__init__() # Обязательная настройка родителя (создает окно)
        
        self.setWindowTitle("Конкурс от Crazy People") # Заголовок окна
        self.resize(400, 200) # Размер окна: 400 ширина, 200 высота

        # Создаем вертикальную сетку (лэйаут), в нее будем складывать элементы
        layout = QVBoxLayout()

        # Создаем надпись с вопросом
        question = QLabel("В каком году канал получил «золотую кнопку» от YouTube?")
        layout.addWidget(question) # Кладем надпись в сетку

        # Создаем 4 радиокнопки (переключатели) с вариантами ответов
        self.rb1 = QRadioButton("2005")
        self.rb2 = QRadioButton("2010")
        self.rb3 = QRadioButton("2015")
        self.rb4 = QRadioButton("2020")

        # По очереди кладем все 4 кнопки в сетку
        layout.addWidget(self.rb1)
        layout.addWidget(self.rb2)
        layout.addWidget(self.rb3)
        layout.addWidget(self.rb4)

        # ПРИВЯЗКА КЛИКОВ (события).
        # Когда кликают на кнопку (clicked), вызывается (connect) нужная функция.
        self.rb1.clicked.connect(self.show_lose) # Клик по 2005 - проигрыш
        self.rb2.clicked.connect(self.show_lose) # Клик по 2010 - проигрыш
        self.rb3.clicked.connect(self.show_win)  # Клик по 2015 - ВЫИГРЫШ!
        self.rb4.clicked.connect(self.show_lose) # Клик по 2020 - проигрыш

        # Устанавливаем нашу сетку внутрь окна
        self.setLayout(layout)

    # Функция, которая срабатывает при правильном ответе
    def show_win(self):
        msg = QMessageBox() # Создаем всплывающее окошко
        msg.setWindowTitle("Победа") # Заголовок окошка
        msg.setText("Верно! Вы выиграли гироскутер.") # Текст внутри
        msg.exec_() # Команда "Показать окошко на экране"

    # Функция, которая срабатывает при неправильном ответе
    def show_lose(self):
        msg = QMessageBox() # Создаем всплывающее окошко
        msg.setWindowTitle("Мимо") # Заголовок окошка
        msg.setText("Нет, в 2015 году. Вы выиграли фирменный плакат.") # Текст
        msg.exec_() # Показываем окошко


# ЗАПУСК ПРОГРАММЫ
if __name__ == '__main__': # Эта строчка говорит: "выполни код ниже, если запускаем этот файл"
    app = QApplication(sys.argv) # Создаем само приложение (движок PyQt)
    window = ContestWindow()     # Создаем экземпляр нашего окна
    window.show()                # Говорим окну: "Покажись!"
    sys.exit(app.exec_())        # Запускаем бесконечный цикл (чтобы окно не закрывалось)
