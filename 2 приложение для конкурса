# ==========================================
import sys  # Нужен для правильного запуска и закрытия программы
# Импортируем нужные нам "кирпичики" из библиотеки PyQt5
from PyQt5.QtWidgets import QApplication, QWidget, QLabel, QRadioButton, QVBoxLayout, QMessageBox


# ==========================================
# ЧАСТЬ 2: СОЗДАЕМ КЛАСС ОКНА
# ==========================================
class ContestWindow(QWidget):  # Наше окно наследуется от базового QWidget
    def __init__(self):
        super().__init__()  # Обязательная настройка родителя (создает пустое окно)
        
        self.setWindowTitle("Конкурс от Crazy People")  # Устанавливаем текст заголовка окна
        self.resize(400, 200)  # Задаем размер окна: ширина 400, высота 200

        # Создаем вертикальный лэйаут (сетку). В него мы будем складывать кнопки друг под другом.
        layout = QVBoxLayout()

        # Создаем надпись с вопросом (QLabel)
        question = QLabel("В каком году канал получил «золотую кнопку» от YouTube?")
        # Кладем эту надпись в нашу сетку
        layout.addWidget(question)

        # Создаем 4 переключателя (радиокнопки) с вариантами ответов
        self.rb1 = QRadioButton("2005")
        self.rb2 = QRadioButton("2010")
        self.rb3 = QRadioButton("2015")
        self.rb4 = QRadioButton("2020")

        # По очереди кладем все 4 кнопки в сетку
        layout.addWidget(self.rb1)
        layout.addWidget(self.rb2)
        layout.addWidget(self.rb3)
        layout.addWidget(self.rb4)

        # ПРИВЯЗКА СОБЫТИЙ.
        # .clicked.connect() означает: "когда по этой кнопке кликнут мышкой, вызови такую-то функцию".
        self.rb1.clicked.connect(self.show_lose)
        self.rb2.clicked.connect(self.show_lose)
        self.rb3.clicked.connect(self.show_win)  # Это правильный ответ, поэтому show_win
        self.rb4.clicked.connect(self.show_lose)

        # Устанавливаем нашу готовую сетку внутрь окна
        self.setLayout(layout)

    # Функция-обработчик для правильного ответа
    def show_win(self):
        msg = QMessageBox()  # Создаем новое всплывающее окошко
        msg.setWindowTitle("Победа")  # Заголовок этого окошка
        msg.setText("Верно! Вы выиграли гироскутер.")  # Текст внутри окошка
        msg.exec_()  # Команда "Показать окошко на экране и ждать нажатия ОК"

    # Функция-обработчик для неправильного ответа
    def show_lose(self):
        msg = QMessageBox()  # Создаем окошко
        msg.setWindowTitle("Мимо")  # Заголовок
        msg.setText("Нет, в 2015 году. Вы выиграли фирменный плакат.")  # Текст
        msg.exec_()  # Показываем его


# ==========================================
# ЧАСТЬ 3: ЗАПУСК ПРОГРАММЫ
# ==========================================
# Эта конструкция нужна, чтобы программа запустилась именно тогда, когда мы её запускаем
if __name__ == '__main__':
    app = QApplication(sys.argv)  # Создаем само приложение (движок PyQt)
    window = ContestWindow()      # Создаем экземпляр нашего окна (по чертежу выше)
    window.show()                 # Командуем окну: "Покажись на экране!"
    sys.exit(app.exec_())         # Запускаем бесконечный цикл программы (чтобы окно не закрывалось само)
