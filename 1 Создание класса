# ==========================================
# ЧАСТЬ 1: СОЗДАЕМ ЧЕРТЕЖ (СУПЕРКЛАСС)
# ==========================================
class Widget:  # Объявляем класс (создаем чертеж) с именем Widget
    
    # Конструктор. Срабатывает, когда мы создаем новый объект.
    # Принимает текст, координату x и координату y.
    def __init__(self, text, x, y): 
        self.text = text  # Создаем свойство "текст" и кладем в него то, что передали
        self.x = x        # Создаем свойство "x" (координата)
        self.y = y        # Создаем свойство "y" (координата)

    # Метод (действие) - печатает информацию об объекте на экран
    def print_info(self): 
        print(f"Надпись: {self.text}")          # Выводим текст на экран
        print(f"Расположение: {self.x} {self.y}") # Выводим координаты


# ==========================================
# ЧАСТЬ 2: СОЗДАЕМ НАСЛЕДНИКА (КНОПКУ)
# ==========================================
class Button(Widget):  # В скобках указываем (Widget) — значит, кнопка забирает всеViewController умения Виджета
    
    # Конструктор кнопки
    def __init__(self, text, x, y):
        # Магия super(). Мы говорим: "Эй, родитель (Widget), сделай свою работу".
        # Это передает текст и координаты в __init__ класса Widget
        super().__init__(text, x, y) 
        
        # Добавляем НОВОЕ свойство, которого не было у Виджета.
        # Изначально кнопка не нажата (False).
        self.is_clicked = False      

    # Метод (действие) - имитация клика по кнопке
    def click(self):
        self.is_clicked = True       # Меняем свойство: теперь кнопка нажата
        print("Вы зарегистрированы") # Печатаем сообщение об успехе


# ==========================================
# ЧАСТЬ 3: ОСНОВНАЯ ПРОГРАММА (БЕЗ ОТСТУПОВ)
# ==========================================
# Создаем объект (экземпляр) кнопки по нашему чертежу Button.
# Передаем текст "Участвовать" и координаты 100, 100.
my_button = Button("Участвовать", 100, 100) 

# Вызываем метод, который кнопка унаследовала от родителя
my_button.print_info()                      

# Функция input() задает вопрос в консоли и ждет, пока пользователь введет ответ.
# Ответ сохраняется в переменную answer.
answer = input("Хотите зарегистрироваться? (да/нет): ")

# Проверяем, что ввел пользователь
if answer == "да":         # Если ввели "да"
    my_button.click()      # Вызываем метод клика (кнопка нажмется)
elif answer == "нет":      # Если ввели "нет"
    print("А жаль")        # Выводим грустный текст
